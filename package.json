{
  "name": "gestvolt-desktop",
  "version": "1.3.0",
  "private": true,
  "description": "GestVolt Desktop - gestao financeira local e offline",
  "main": "electron/main.cjs",
  "author": "GestVolt",
  "license": "UNLICENSED",
  "scripts": {
    "start": "vite --host 127.0.0.1",
    "desktop:dev": "node scripts/copy-sql-wasm.mjs && concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && electron .\"",
    "build": "node scripts/copy-sql-wasm.mjs && vite build",
    "typecheck": "tsc --noEmit",
    "desktop:dist": "npm run build && electron-builder --win --publish never",
    "desktop:dist:installer": "npm run build && electron-builder --win nsis --publish never"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/react": "~19.2.6",
    "@types/react-dom": "19.2.3",
    "@types/sql.js": "^1.4.9",
    "concurrently": "^9.1.2",
    "electron": "^44.7.0",
    "electron-builder": "^26.0.12",
    "typescript": "~5.9.2",
    "vite": "^8.3.4",
    "wait-on": "^8.0.3",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-native": "0.83.1",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-svg": "15.15.3",
    "react-native-web": "^0.21.2",
    "sql.js": "^1.14.2"
  },
  "build": {
    "appId": "com.gestvolt.desktop",
    "productName": "GestVolt",
    "artifactName": "GestVolt-Setup-${version}.${ext}",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "assets/**/*",
      "package.json"
    ],
    "win": {
      "icon": "assets/gestvolt.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "portable": {
      "artifactName": "GestVolt-Portable-${version}.${ext}"
    }
  }
}
